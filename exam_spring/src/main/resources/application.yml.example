# ============================================================
# 本地开发配置模板（.example）
# ============================================================
# 用法：
#   copy application.yml.example application.yml    # Windows CMD
#   cp application.yml.example application.yml      # Linux / macOS / Git Bash
# 然后修改下面的数据库账号密码、Redis 地址等本地环境相关项。
#
# 注意：application.yml 本身已被 .gitignore 排除（含数据库密码等敏感信息），
#      不会提交到仓库；本模板仅提供字段结构参考。
# ============================================================
spring:
  application:
    name: exam_spring
  datasource:
    # 数据库需提前创建：CREATE DATABASE exam_online_system DEFAULT CHARSET utf8mb4;
    url: jdbc:mysql://localhost:3306/exam_online_system?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&zeroDateTimeBehavior=convertToNull&transformedBitIsBoolean=true&allowMultiQueries=true
    username: root
    password: your_password          # ← 改成你的 MySQL 密码
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: 150
      minimum-idle: 20
      connection-timeout: 10000
      idle-timeout: 300000
      max-lifetime: 900000
  data:
    redis:
      host: localhost
      port: 6379
      database: 1

server:
  port: 8081
  tomcat:
    accept-count: 300
    threads:
      max: 500
      min-spare: 50

logging:
  level:
    org.springframework.security: WARN
    com.ai.exam_spring: DEBUG
  pattern:
    dateformat: HH:mm:ss

mybatis-plus:
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
    default-enum-type-handler: com.baomidou.mybatisplus.core.handlers.MybatisEnumTypeHandler
    default-executor-type: batch # 启用批量模式
  global-config:
    db-config:
      logic-delete-field: isDeleted # 避免逻辑删除干扰
  type-aliases-package: com.ai.exam_spring.entity

springdoc:
  default-flat-param-object: true

knife4j:
  enable: true
  setting:
    language: zh_cn
    enable-swagger-models: true  # 在 UI 底部显示实体类（Swagger Models）列表
    swagger-model-name: 实体类列表

management:
  endpoints:
    web:
      exposure:
        include: health,info,prometheus,metrics
  metrics:
    tags:
      application: exam-spring
  endpoint:
    prometheus:
      enabled: true

rocketmq:
  name-server: localhost:9876
  producer:
    group: exam-producer-group
    send-message-timeout: 3000
    retry-times-when-send-failed: 3
