<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ai</groupId>
        <artifactId>exam-cloud</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.ai</groupId>
    <artifactId>exam_gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>exam_gateway</name>
    <description>在线考试系统 API 网关</description>

    <!--
      本地开发说明（Nacos 走 Docker，端口映射见仓库根 docker-compose.yml）：
        宿主 18848(HTTP) -> 容器 8848，宿主 19848(gRPC) -> 容器 9848
      Nacos 2.x 客户端 gRPC 端口 = HTTP 端口 + 1000，因此 bootstrap.yml 的 server-addr
      必须写 127.0.0.1:18848（客户端自动推导 gRPC 19848）。
      网关路由 lb://exam-core 依赖 Nacos 里的实例列表，服务名中的下划线会导致
      URI host 解析为 null，故服务名统一使用连字符格式。
    -->


    <dependencies>
        <!-- ================== 网关核心 ================== -->
        <!-- 注意：绝不能同时引入 spring-boot-starter-web（Servlet），会与 WebFlux 冲突 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>

        <!-- ================== 负载均衡 ================== -->
        <!-- lb:// 协议由它支撑。nacos-discovery 不会传递引入它，必须显式声明，
             否则网关启动正常但转发时抛 "Invalid host: lb://xxx" -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- ================== 服务注册发现 ================== -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- 让 bootstrap.yml 生效（Spring Boot 3 默认不加载） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>

        <!-- ================== 运维监控 ================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ================== 接口文档聚合（Knife4j 网关聚合） ================== -->
        <!-- 专门适配 Spring Cloud Gateway(WebFlux)，不会引入 servlet-web，与网关共存；
             版本与后端 knife4j-openapi3(4.4.0) 对齐，否则聚合文档协议不兼容 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-gateway-spring-boot-starter</artifactId>
            <version>4.4.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
