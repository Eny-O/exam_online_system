<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ai.exam_auth_user.mapper.RoleMapper">

    <!-- 查询指定角色已关联的权限ID -->
    <select id="getPermissionIdsByRoleId" resultType="java.lang.Integer">
        SELECT permission_id
        FROM sys_role_permission
        WHERE role_id = #{roleId}
    </select>

    <!-- 删除角色的全部权限关联 -->
    <delete id="deleteRolePermissions">
        DELETE FROM sys_role_permission
        WHERE role_id = #{roleId}
    </delete>

    <!-- 批量插入角色-权限关联 -->
    <insert id="batchInsertRolePermissions">
        INSERT INTO sys_role_permission (role_id, permission_id)
        VALUES
        <foreach collection="permissionIds" item="pid" separator=",">
            (#{roleId}, #{pid})
        </foreach>
    </insert>

</mapper>
