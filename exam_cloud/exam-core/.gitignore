# ================== Java / Maven ==================
target/
*.class
*.jar
*.war
*.ear

# ================== IDE ==================
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.project
.classpath
.settings/

# ================== 配置文件（含敏感信息） ==================
src/main/resources/application.yml
src/main/resources/application-*.yml
# application-docker.yml 仅含部署连接信息（不含数据库密码之外的敏感项），允许入仓，
# 使 CI 构建的镜像自带 docker profile 配置，实现 clone 即 docker compose up。
!src/main/resources/application-docker.yml

# ================== 日志 ==================
*.log
logs/

# ================== 操作系统 ==================
.DS_Store
Thumbs.db
desktop.ini

# ================== 其他 ==================
*.swp
*.swo
*~

# ================== Docker 中间件运行时数据 ==================
# RocketMQ 消息存储与日志（由 compose 挂载到宿主目录，仅本地保留）
rocketmq/store/
rocketmq/logs/
rocketmq/store.bak-*/
