# 多阶段构建：Maven 编译 -> JRE 运行
# 构建上下文需为仓库根（compose 中 context: .），以便访问 exam_cloud 整个聚合工程
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY exam_cloud ./exam_cloud
WORKDIR /app/exam_cloud
# -am 连带构建依赖模块（exam_common / exam_api）
RUN mvn -B -q -pl exam-core -am package -DskipTests

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /app/exam_cloud/exam-core/target/exam-core-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "app.jar"]
